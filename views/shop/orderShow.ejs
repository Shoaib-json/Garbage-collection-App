<% layout("./layouts/boilerplate.ejs") -%>
<h1>Order Details</h1>

<p>Order ID: <%= order._id %></p>
<p>Status: <%= order.status %></p>

<table>
  <thead>
    <tr>
      <th>Product</th>
      <th>Quantity</th>
      <th>Price Each</th>
    </tr>
  </thead>
  <tbody>
    <% order.items.forEach(item => { %>
      <tr>
        <td><%= item.product ? item.product.caption : 'Deleted Product' %></td>
        <td><%= item.quantity %></td>
        <td>$<%= item.price %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<h3>Total Price: $<%= order.totalPrice %></h3>
