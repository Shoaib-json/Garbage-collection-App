<% layout("./layouts/boilerplate.ejs") -%>
<h1>My Orders</h1>

<% if (orders && orders.length > 0) { %>
  <ul>
    <% orders.forEach(order => { %>
      <li>
        <a href="/orders/<%= order._id %>">Order ID: <%= order._id %></a>
        | Status: <%= order.status %>
        | Total: $<%= order.totalPrice %>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>No orders found.</p>
<% } %>
