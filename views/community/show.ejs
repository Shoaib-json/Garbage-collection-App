<% layout("/layouts/boilerplate") -%>



<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card event-container shadow-sm">
        <div class="card-body">
          <!-- Event Content -->
          <div class="event">
            <h2 class="mb-4"><%= q.caption %></h2>
            <img src="<%= q.image.url %>" alt="Event Image" class="event-image img-fluid">
          </div>

          
          <% if (currUser && currUser._id.equals(q.user._id)){%>
          <form action="/community/<%=q._id%>/delete?_method=DELETE" method="post">
            <button type="submit" class="btn like-btn">
              <i ></i> Delete
            </button>
          </form>
          <%}%>
          <div class="d-flex justify-content-between align-items-center mb-4">
            <form action="/community/<%=q._id%>/like?_method=PUT" method="post">
              <button type="submit" class="btn like-btn">
                <i class="bi bi-heart"></i> Like
              </button>
            </form>

            
            <div class="text-muted">
              <small>Posted <time datetime="2023-01-01">recently</time></small>
            </div>
          </div>

          <!-- Comment Form -->
          <div class="mb-4">
            <form action="/community/<%=q._id%>/comment?_method=PUT" method="post" class="comment-form">
              <div class="input-group">
                <input name="comment" class="form-control comment-input" placeholder="Write a comment..." required>
                <button type="submit" class="btn comment-btn">Comment</button>
              </div>
            </form>
          </div>

          <!-- Comments Section -->
          <% if (q.comments && q.comments.length > 0) { %>
            <div class="comments-section">
              <h5 class="comment-title">Comments (<%= q.comments.length %>)</h5>
              
              <% for (let p of q.comments) { %>
                <div class="comment mb-3">
                  <p class="comment-user mb-1">
                    <i class="bi bi-person-circle"></i> <%= p.user.username %>
                  </p>
                  <p class="comment-text mb-0"><%= p.comment %></p>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <p class="text-center text-muted">No comments yet. Be the first to comment!</p>
          <% } %>
        </div>
      </div>
      
      <div class="text-center mt-4">
        <a href="/community" class="btn btn-outline-success">
          <i class="bi bi-arrow-left"></i> Back to Community
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Add Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">