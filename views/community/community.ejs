<% layout("/layouts/boilerplate") -%>
<body>
    <button><a href="/community/post">Add post</a></button>
    
    <% if (q && q.length > 0) { %>
        <% for (let p of q) { %>
            <a href="/community/<%= p._id %>">
                <div class="event">
                    <h2><%= p.caption %></h2>
                    <img src="<%= p.image.url %>" alt="Event Image" width="200">
                </div>
                <hr>
            </a>
        <% } %>
    <% } else { %>
        <p>No posts available.</p>
    <% } %>
</body>
</html>