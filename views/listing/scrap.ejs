<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scrap Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-5">
        <h1 class="text-center mb-4">Scrap Management</h1>

        <!-- Form to Add Scrap -->
        <form action="/re/submit" method="POST" class="border p-4 shadow-sm rounded">
            <div class="mb-3">
                <label for="category" class="form-label">Category</label>
                <select id="category" name="category" class="form-select" required>
                    <option value="" disabled selected>Select a category</option>
                    <option value="plastic">Plastic</option>
                    <option value="iron">Iron</option>
                    <option value="aluminium">Aluminium</option>
                    <option value="copper">Copper</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="price" class="form-label">Price</label>
                <input type="number" id="price" name="price" class="form-control" placeholder="Enter price per kg" required>
            </div>

            <div class="mb-3">
                <label for="weight" class="form-label">Weight</label>
                <input type="number" id="weight" name="weight" class="form-control" placeholder="Enter weight in kg">
            </div>

            <button type="submit" class="btn btn-primary">Add Scrap</button>
        </form>

        <!-- Display List of Scraps (Static Data Example) -->
        <div class="mt-5">
            <h2 class="mb-3">Scrap List</h2>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Price (per kg)</th>
                        <th>Weight (kg)</th>
                        <th>Created At</th>
                        <th>User</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Plastic</td>
                        <td>15</td>
                        <td>20</td>
                        <td>2025-01-17 10:00</td>
                        <td>John Doe</td>
                    </tr>
                    <tr>
                        <td>Iron</td>
                        <td>10</td>
                        <td>30</td>
                        <td>2025-01-16 14:30</td>
                        <td>Jane Smith</td>
                    </tr>
                    <tr>
                        <td>Aluminium</td>
                        <td>20</td>
                        <td>25</td>
                        <td>2025-01-15 09:45</td>
                        <td>Mark Johnson</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
