<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/<%=q.id%>/edit?_method=PUT" method="post">
        <div class="container">

                
                <div class="form-group">
                    <label for="city">City:</label>
                    <input 
                        type="text" 
                        id="city" 
                        name="city" 
                        value="<%=q.city%>" 
                        required>
                </div>
    
                <!-- Street Input -->
                <div class="form-group">
                    <label for="street">Street:</label>
                    <input 
                        type="text" 
                        id="street" 
                        name="street" 
                        value='<%=q.street%>'
                        required>
                </div>
    
                <!-- Pincode Input -->
                <div class="form-group">
                    <label for="pincode">Pincode:</label>
                    <input 
                        type="number" 
                        id="pincode" 
                        name="pincode" 
                        value="<%=q.pincode%>" 
                        required>
                </div>
    
                <!-- House Number Input -->
                <div class="form-group">
                    <label for="houseNo">House Number:</label>
                    <input 
                        type="text" 
                        id="houseNo" 
                        name="houseNo" 
                        value="<%=q.houseNo%>">
                </div>
                <div class="form-group">
                    <label for="houseNo">House Number:</label>
                    <input 
                        type="text" 
                        id="phoneNum" 
                        name="phoneNum" 
                        value="<%=q.phoneNum %>">
                </div>
    
                <!-- Submit Button -->
                <button type="submit">Add Address</button>
    </form>
</body>
</html>