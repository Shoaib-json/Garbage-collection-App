<% layout("/layouts/boilerplate") -%>
<body>
  <button><a href="/user/address">NEW ADD</a></button>

  <h2>User Details</h2>
  <p><strong>Username:</strong> <%= q.username %></p>
  <p><strong>Email:</strong> <%= q.email %></p>

  <h3>Address(es):</h3>

  <% if (q.address && q.address.length > 0) { %>
    <% q.address.forEach(function(addr, index) { %>
      <div class="address-container">
        <p><strong>Address <%= index + 1 %>:</strong></p>
        <ul>
          
          <li><strong>City:</strong> <%= addr.city %></li>
          <li><strong>Pincode:</strong> <%= addr.pincode %></li>
          <li><strong>Contact</strong> <%= addr.phoneNum %></li>
          <li><strong>Street</strong> <%= addr.street %></li>
          <form method="get" action="/<%=addr._id%>/edit">
            <button>Edit</button>
          </form>
          
        </ul>
      </div>
      <hr />
    <% }) %>
  <% } else { %>
    <p>No address found.</p>
  <% } %>

</body>
</html>
