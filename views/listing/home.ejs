<% layout("/layouts/boilerplate") -%>
<body>

    <header>
        <h1>Welcome to RecycleConnect</h1>
        <p>Your hub for a cleaner and greener future</p>
    </header>

    <nav>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/contact">Contact</a>
    </nav>

