<% layout("/layouts/boilerplate") -%>
<body>

    <header>
        <h1>Welcome to RecycleConnect</h1>
        <p>Your hub for a cleaner and greener future</p>
    </header>


    <div class="hero">
        <h1>Join the Movement</h1>
        <p>Together, we can reduce waste and build a sustainable future. Explore our services to learn how you can make a difference.</p>
    </div>

    <div class="container">
        <div class="features">
            <a href="/event" style="text-decoration: none; color: inherit;">
                <div class="feature">
                    <img src="https://cdn-icons-png.flaticon.com/128/1327/1327264.png" alt="Recycling Icon">
                    <h3>Recycling Programs</h3>
                    <p>We offer various programs to make recycling easy and effective.</p>
                </div>
            </a>
            
            
            <div class="feature">
                <img src="https://cdn.iconscout.com/icon/premium/png-512-thumb/recycle-9819845-7957279.png?f=webp&w=256" alt="Technology Icon">
                <h3>Technology Solutions</h3>
                <p>Our innovative tech helps in waste tracking and optimization.</p>
            </div>
            <div class="feature">
                <img src="https://cdn-icons-png.flaticon.com/128/18616/18616615.png" alt="Community Icon">
                <h3>Community Engagement</h3>
                <p>We believe in engaging communities to promote sustainability.</p>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2025 RecycleConnect | <a href="/privacy-policy">Privacy Policy</a> | <a href="/terms">Terms of Service</a></p>
    </footer>

