<% layout("/layouts/boilerplate") -%>

<body>
    <h1>User Details</h1>
    <p><strong>Email:</strong> <%= user.email %></p>
    <p><strong>Username:</strong> <%= user.username %></p>
    <p><strong>Created At:</strong> <%= user.createAt.toDateString() %></p>

    <h2>Addresses</h2>
    <% if (user.address.length > 0) { %>
        <ul>
            <% user.address.forEach(addr => { %>
                <li>
                    <p><strong>City:</strong> <%= addr.city %></p>
                    <p><strong>Street:</strong> <%= addr.street %></p>
                    <p><strong>Pincode:</strong> <%= addr.pincode %></p>
                    <p><strong>House No:</strong> <%= addr.houseNo %></p>
                    <p><strong>Phone Number:</strong> <%= addr.phoneNum %></p>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No addresses found.</p>
    <% } %>
    
    //this form for new address 
    <div class="container">
        <h1>Add Address</h1>
        <form action="/user/<%= user.id %>" method="POST">
            
            <div class="form-group">
                <label for="city">City:</label>
                <input 
                    type="text" 
                    id="city" 
                    name="city" 
                    placeholder="Enter city" 
                    required>
            </div>

            <!-- Street Input -->
            <div class="form-group">
                <label for="street">Street:</label>
                <input 
                    type="text" 
                    id="street" 
                    name="street" 
                    placeholder="Enter street" 
                    required>
            </div>

            <!-- Pincode Input -->
            <div class="form-group">
                <label for="pincode">Pincode:</label>
                <input 
                    type="number" 
                    id="pincode" 
                    name="pincode" 
                    placeholder="Enter pincode" 
                    required>
            </div>

            <!-- House Number Input -->
            <div class="form-group">
                <label for="houseNo">House Number:</label>
                <input 
                    type="text" 
                    id="houseNo" 
                    name="houseNo" 
                    placeholder="Enter house number (optional)">
            </div>
            <div class="form-group">
                <label for="houseNo">House Number:</label>
                <input 
                    type="text" 
                    id="houseNo" 
                    name="phoneNum" 
                    placeholder="Enter phone number">
            </div>

            <!-- Submit Button -->
            <button type="submit">Add Address</button>
        </form>
    </div>
</body>
</html>
