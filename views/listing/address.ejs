<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Address</title>
</head>
<body>
    <div class="container">
        <h1>Add Address</h1>
        <form action="/user/<%= q %>" method="POST">
            
            <div class="form-group">
                <label for="city">City:</label>
                <input 
                    type="text" 
                    id="city" 
                    name="city" 
                    placeholder="Enter city" 
                    required>
            </div>

            <!-- Street Input -->
            <div class="form-group">
                <label for="street">Street:</label>
                <input 
                    type="text" 
                    id="street" 
                    name="street" 
                    placeholder="Enter street" 
                    required>
            </div>

            <!-- Pincode Input -->
            <div class="form-group">
                <label for="pincode">Pincode:</label>
                <input 
                    type="number" 
                    id="pincode" 
                    name="pincode" 
                    placeholder="Enter pincode" 
                    required>
            </div>

            <!-- House Number Input -->
            <div class="form-group">
                <label for="houseNo">House Number:</label>
                <input 
                    type="text" 
                    id="houseNo" 
                    name="houseNo" 
                    placeholder="Enter house number (optional)">
            </div>
            <div class="form-group">
                <label for="houseNo">House Number:</label>
                <input 
                    type="text" 
                    id="houseNo" 
                    name="phoneNum" 
                    placeholder="Enter phone number">
            </div>

            <!-- Submit Button -->
            <button type="submit">Add Address</button>
        </form>
    </div>
</body>
</html>
