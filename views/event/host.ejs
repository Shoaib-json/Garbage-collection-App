<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Event</title>
</head>
<body>
    <h1>Create Event</h1>
    <form action="/event/create-post" method="POST" >
        <!-- Address Section -->
        <fieldset>
            <legend>Address</legend>
            <label for="city">City:</label>
            <input type="text" id="city" name="address[city]" required>
            <br>
            <label for="country">Country:</label>
            <input type="text" id="country" name="address[country]" required>
            <br>
            <label for="place">Place:</label>
            <input type="text" id="place" name="address[place]" required>
        </fieldset>
        <br>

        <!-- Description Section -->
        <label for="description">Description:</label>
        <textarea id="description" name="description" required></textarea>
        <br>

        <!-- Date Section -->
        <label for="date">Date:</label>
        <input type="date" id="date" name="date" required>
        <br><br>

        <!-- Poster Section -->
        <fieldset>
            <legend>Poster</legend>
            <label for="url">Poster URL:</label>
            <input  id="url" name="poster[url]" required>
            <br>
            <label for="filename">Poster Filename:</label>
            <input type="text" id="filename" name="poster[filename]" value="poster101" required>
        </fieldset>
        <br>

        <!-- Submit Button -->
        <button type="submit">Create Event</button>
    </form>
</body>
</html>
